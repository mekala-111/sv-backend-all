# App
NODE_ENV=development
PORT=4000
APP_BASE_URL=https://api.svlive.in
PUBLIC_EVENT_BASE_URL=https://live.svlive.in
VENDOR_PANEL_BASE_URL=https://vendor.svlive.in

# Database (MySQL)
# mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://sv_live_user:changeme@localhost:3306/sv_live"

# JWT
JWT_ACCESS_SECRET=replace_with_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Token/secret encryption (AES-256-GCM key, 32 bytes hex = 64 chars)
TOKEN_ENCRYPTION_KEY=replace_with_64_char_hex_string

# Password reset / OTP
OTP_EXPIRY_MINUTES=10

# S3-compatible storage
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=sv-live-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# YouTube / Google OAuth
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=https://api.svlive.in/api/youtube/callback

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SV LIVE <no-reply@svlive.in>"

# Razorpay (payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
