# App
NODE_ENV=development
PORT=5161
APP_BASE_URL=http://localhost:5161
PUBLIC_EVENT_BASE_URL=http://localhost:3000
VENDOR_PANEL_BASE_URL=http://localhost:3001

# MongoDB Atlas
# Replace <db_password> with your Atlas password (URL-encode special chars)
MONGODB_URI=mongodb+srv://venkey:Venkey0055@sv-events.bmiefbg.mongodb.net/sv_live?retryWrites=true&w=majority&appName=SV-EVENTS

# JWT
JWT_ACCESS_SECRET=replace_with_long_random_secret_at_least_32_chars
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret_32
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Token/secret encryption (AES-256-GCM key, 32 bytes hex = 64 chars)
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Password reset / OTP
OTP_EXPIRY_MINUTES=10

# Seed (optional)
SEED_SUPER_ADMIN_EMAIL=admin@svlive.in
SEED_SUPER_ADMIN_PASSWORD=Admin@123
SEED_DEMO_DATA=true

# S3-compatible storage
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=sv-live-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# YouTube / Google OAuth
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:5161/api/youtube/callback

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SV LIVE <no-reply@svlive.in>"

# Razorpay (payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
